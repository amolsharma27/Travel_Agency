# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/travel_hotel_platform

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d
OTP_EXPIRE_MINUTES=10

# ---- Email (Nodemailer) ----
# If left blank, emails are logged to the console instead of sent (dev-safe default)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Travel & Stay <no-reply@travelstay.com>"

# ---- Cloudinary ----
# If left blank, image uploads fall back to local disk storage (/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
# If left blank, payment endpoints return mock/sandbox orders so the booking
# flow can be built and tested end-to-end before real keys are available
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Google Maps (used by the frontend, kept here for reference) ----
GOOGLE_MAPS_API_KEY=
